{
  "name": "nekochat-reloaded-pc",
  "productName": "Nekochat Reloaded",
  "version": "1.4.0",
  "private": true,
  "description": "Windows XP styled Nekochat desktop client built with Electron.",
  "author": "xKaMikax",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:windows": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.komdu.nekochat",
    "productName": "Nekochat Reloaded",
    "directories": { "output": "release" },
    "files": ["**/*", "!node_modules/**", "!release/**", "!android_client/**", "!iphone_client/**", "!web_client/**", "!tools/__pycache__/**", "!PROJECT_MAP.md", "!index.md"],
    "linux": { "target": ["AppImage", "deb"], "category": "Network;Chat" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
